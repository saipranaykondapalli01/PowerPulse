# PowerPulse server configuration (copy to your environment; never commit real secrets)
SPRING_PROFILES_ACTIVE=dev
PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=powerpulse
# Required outside the dev/test profiles; at least 32 random bytes, e.g. `openssl rand -base64 48`
POWERPULSE_JWT_SECRET=
POWERPULSE_JWT_EXPIRY_MINUTES=480
# true behind HTTPS
POWERPULSE_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=10000
READING_RETENTION_DAYS=90
